# Copy to .env (gitignored) and set a real password:
#   cp .env.example .env
#   openssl rand -base64 24   # paste the output below
POSTGRES_USER=pkm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pkm
# Host port on 127.0.0.1. Container always listens on 5432 internally.
PKM_PG_PORT=5678
# Host directory mounted at /backups in the container; bin/backup-pkm.sh writes here.
PKM_BACKUP_DIR=/Users/lmullen/backups/pkm
